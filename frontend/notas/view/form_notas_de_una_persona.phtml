<script>
    $(function () {
        $("#f_acta").datepicker();
        fnjs_tipo_acta_cmb();
    });

    fnjs_es_modo_acta = function () {
        return $('input[name=tipo_acta]:checked').val() == <?= (int) $formato_acta ?>;
    }

    fnjs_tipo_acta_cmb = function () {
        var esActa = fnjs_es_modo_acta();
        $('#bloque_acta_propio').toggle(esActa);
        $('#bloque_acta_certificado').toggle(!esActa);
    }

    fnjs_limpiar_acta_resuelta = function () {
        $('#acta').val('');
    }

    fnjs_buscar_acta = function () {
        var mod = $('#mod').val();
        if (mod !== 'nuevo' || !fnjs_es_modo_acta()) {
            return;
        }
        var actaNum = $('#acta_num').val().trim();
        if (!/^\d+\/\d{2}$/.test(actaNum)) {
            return;
        }

        $.ajax({
            url: '<?= $url_buscar_acta ?>',
            type: 'post',
            data: 'acta=' + encodeURIComponent(actaNum)
                + '&acta_sigla=' + encodeURIComponent($('#acta_sigla').val())
                + '<?= $h_buscar_acta ?>',
            dataType: 'json'
        })
            .done(function (json) {
                if (!json || json.success !== true) {
                    alert(<?= json_encode(_("respuesta") . ": ") ?> + (json && json.mensaje ? json.mensaje : ''));
                    return;
                }
                var rta_json = (typeof json.data === 'string') ? JSON.parse(json.data) : json.data;
                id_asignatura = rta_json.id_asignatura;
                if (id_asignatura == 'no') {
                    $('#id_nivel').val('');
                    $('#f_acta').val('');
                    $('#id_activ').val('');
                    $('#nom_activ').text('');
                    $("#epoca1").prop("checked", true);
                    $('#acta').val('');
                    fnjs_cmb_opcional();
                } else {
                    fecha = rta_json.f_acta;
                    id_activ = rta_json.id_activ;
                    nom_activ = rta_json.nom_activ;
                    acta = rta_json.acta;
                    epoca = rta_json.epoca;
                    id_epoca = '#epoca' + epoca;
                    $('#acta').val(acta);
                    $('#f_acta').val(fecha);
                    $('#id_activ').val(id_activ);
                    $('#nom_activ').text(nom_activ);
                    $(id_epoca).prop("checked", true);
                    if (id_asignatura > 3000) {
                        op_todas = <?= $op_genericas ?>;
                        niveles = $('#id_nivel option');
                        niveles.each(function () {
                            idNivel = $(this).val();
                            if (op_todas.includes(idNivel)) {
                                $('#id_nivel').val(idNivel);
                                fnjs_cmb_opcional(id_asignatura);
                                return false;
                            }
                        });
                    } else {
                        id_nivel = rta_json.id_nivel;
                        $('#id_nivel').val(id_nivel);
                    }
                }
            });
    }

    fnjs_cerrar = function () {
        $('#div_modificar').html('');
        $('#div_modificar').width('0');
        $('#div_modificar').height('0');
        $('#div_modificar').removeClass('ventana');
        document.getElementById("overlay").style.display = "none";
    }

    fnjs_modificar = function (id_item) {
        $('#div_modificar').addClass('ventana');
        $('#div_modificar').width('auto');
        $('#div_modificar').height('auto');
        document.getElementById("overlay").style.display = "block";

        var url = '<?= $url_actividad_buscar ?>';
        var parametros = 'dl_org=&f_acta_iso=<?= $f_acta_iso ?><?= $h_actividad_buscar ?>';
        fnjs_update_div('#div_modificar', url + '?' + parametros);
    }

    fnjs_buscar_ca = function () {
        var dl_org = $('#dl_org').val();
        fnjs_ajax_json_html({
            url: '<?= $url_actividad_buscar ?>',
            data: 'f_acta_iso=<?= $f_acta_iso ?>&dl_org=' + dl_org + '<?= $h_actividad_buscar ?>',
            target: '#div_modificar'
        });
    }

    fnjs_update_activ = function () {
        id_activ = $("#id_activ_sel option:selected").val();
        nom_activ = $("#id_activ_sel option:selected").text();

        $('#id_activ').val(id_activ);
        $('#nom_activ').text(nom_activ);

        fnjs_cerrar();
    }

    fnjs_cmb_preceptor = function () {
        if ($('#preceptor').prop('checked')) {
            $.ajax({
                url: '<?= $url_posibles_preceptores ?>',
                type: 'post',
                data: '<?= ltrim($h_posibles_preceptores, '&') ?>',
                dataType: 'json'
            })
                .done(function (json) {
                    $('#lst_preceptores').html(fnjs_construir_desplegable(json));
                });
        } else { // al cambiar a NO preceptor
            $('#lst_preceptores').html('');
        }
    }
    /**
     * se ejecuta al cambiar el desplegable $oDesplegaAsignaturas
     * @returns desplegable de posibles asignaturas opcionales
     */
    fnjs_cmb_opcional = function (id_asignatura = '') {
        var id = $('#id_nivel').val();
        if (<?= $condicion_js; ?>) { //solo si es opcional
            var id_nom = $('#id_pau').val();
            $.ajax({
                url: '<?= $url_posibles_opcionales ?>',
                type: 'post',
                data: 'id_nom=' + id_nom + '<?= $h_posibles_opcionales ?>',
                dataType: 'json'
            })
                .done(function (json) {
                    $('#lst_opcionales').html(fnjs_construir_desplegable(json));
                    $('#id_asignatura').val(id_asignatura);
                });
        } else { // al cambiar a NO opcional
            $('#lst_opcionales').html('<input type="hidden" id="id_asignatura" name="id_asignatura" value="1">');
        }
    }
    fnjs_nota = function () {
        var num;
        var max;
        var sit;

        num = $('#nota_num').val();
        max = $('#nota_max').val();
        sit = $('#id_situacion').val();
        if (!num) $('#id_situacion').val('0');
        num = parseFloat(num);
        if (typeof num == 'number' && num > 1) {
            $('#id_situacion').val(10);
        }
        max_default = <?= $nota_max_default ?>;
        if (!max) $('#nota_max').val(max_default);
    }
    fnjs_guardar = function (formulario) {
        var err = 0;
        var mod = $('#mod').val();
        var f_acta = $('#f_acta').val();
        var situacion = $('#id_situacion').val();
        var id_nivel = $('#id_nivel').val();
        var esActa = fnjs_es_modo_acta();
        var acta = '';

        if (esActa) {
            var actaNum = $('#acta_num').val().trim();
            var sigla = $('#acta_sigla').val();
            if (actaNum !== '') {
                if (!/^\d+\/\d{2}$/.test(actaNum)) {
                    alert(<?= json_encode(_("El número de acta debe tener el formato num/aa (ej. 12/26)")) ?>);
                    err = 1;
                } else {
                    acta = sigla + ' ' + actaNum;
                    $('#acta').val(acta);
                }
            }
        } else {
            var dl = $('#acta_cert_dl').val();
            var certNum = $('#acta_cert_num').val().trim();
            if (dl !== '') {
                acta = certNum !== '' ? dl + ' ' + certNum : dl;
            } else {
                acta = certNum;
            }
            $('#acta').val(acta);
        }

        if (id_nivel < 9990) {
            if (situacion == 10) {
                var num = $('#nota_num').val();
                var max = $('#nota_max').val();
                num = parseFloat(num);
                max = parseFloat(max);
                if (isNaN(num)) {
                    alert(<?= json_encode(_("valor de nota no válido")) ?>);
                    err = 1;
                }
                if (num < 0 || num > max) {
                    alert(<?= json_encode(_("nota fuera de rango")) ?>);
                    err = 1;
                }
            }
            var arr_no_superadas = [<?= $lista_situacion_no_acta ?>];
            if (!acta && !(jQuery.inArray(situacion, arr_no_superadas) !== -1)) {
                alert(<?= json_encode(_("debe llenar el campo del acta")) ?>);
                if (esActa) {
                    $('#acta_num').trigger("focus");
                } else if ($('#acta_cert_dl').length) {
                    $('#acta_cert_dl').trigger("focus");
                } else {
                    $('#acta_cert_num').trigger("focus");
                }
                err = 1;
            }
        }
        if (f_acta) {
            if (!fnjs_comprobar_fecha('#f_acta', <?= $locale_us ?>)) {
                err = 1;
            }
        } else {
            alert("debe llenar el campo fecha acta");
            err = 1;
        }

        if (err != 1) {
            var url_guardar = (mod === 'editar')
                ? '<?= $url_persona_nota_editar ?>'
                : '<?= $url_persona_nota_nueva ?>';
            $(formulario).attr('action', url_guardar);
            $(formulario).one("submit", function () {
                $.ajax({
                    url: $(this).attr('action'),
                    type: 'post',
                    data: $(this).serialize(),
                    dataType: 'json'
                })
                    .done(function (json) {
                        if (!json || json.success !== true) {
                            alert(<?= json_encode(_("respuesta") . ": ") ?> + ((json && json.mensaje) ? json.mensaje : ''));
                        } else {
                            var msgOk = '';
                            try {
                                var d = json.data;
                                if (typeof d === 'string' && d !== '') {
                                    d = JSON.parse(d);
                                }
                                if (d && d.mensaje) {
                                    msgOk = d.mensaje;
                                }
                            } catch (e) {}
                            if (msgOk) {
                                alert(msgOk);
                            }
                            <?= $oPosicion->jsNavAtrasToDossiersParent(); ?>
                        }
                    });
                return false;
            });
            $(formulario).trigger("submit");
            $(formulario).off();
        }
    }


</script>
