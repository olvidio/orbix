<?= $oPosicion->mostrarNavAtras(1); ?>
<h2 class="titulo"><?= _("Residuo de notas de otras regiones") ?></h2>
<p><?= _("Comprobación, en el orden en que hay que mirarla, antes de borrar e_notas_otra_region_stgr.") ?></p>
<?php foreach ($pasos as $paso) :
    if (!is_array($paso)) {
        continue;
    }
    $tablas = is_array($paso['tablas'] ?? null) ? $paso['tablas'] : [];
    ?>
    <h3><?= (int) ($paso['numero'] ?? 0) ?>. <?= htmlspecialchars((string) ($paso['titulo'] ?? ''), ENT_QUOTES, 'UTF-8') ?></h3>
    <p><?= htmlspecialchars((string) ($paso['texto'] ?? ''), ENT_QUOTES, 'UTF-8') ?></p>
    <?php foreach ($tablas as $tabla) :
        if (!is_array($tabla)) {
            continue;
        }
        $cabeceras = is_array($tabla['cabeceras'] ?? null) ? $tabla['cabeceras'] : [];
        $filas = is_array($tabla['filas'] ?? null) ? $tabla['filas'] : [];
        $tituloTabla = (string) ($tabla['titulo'] ?? '');
        if ($tituloTabla !== '') : ?>
            <h4><?= htmlspecialchars($tituloTabla, ENT_QUOTES, 'UTF-8') ?></h4>
        <?php endif; ?>
        <?php if ($filas === []) : ?>
            <p><?= _("ninguna fila") ?></p>
        <?php else : ?>
            <table class="tabla_presentacion">
                <tr>
                    <?php foreach ($cabeceras as $cabecera) : ?>
                        <th><?= htmlspecialchars((string) $cabecera, ENT_QUOTES, 'UTF-8') ?></th>
                    <?php endforeach; ?>
                </tr>
                <?php foreach ($filas as $fila) :
                    if (!is_array($fila)) {
                        continue;
                    } ?>
                    <tr>
                        <?php foreach ($fila as $celda) : ?>
                            <td><?= htmlspecialchars((string) $celda, ENT_QUOTES, 'UTF-8') ?></td>
                        <?php endforeach; ?>
                    </tr>
                <?php endforeach; ?>
            </table>
        <?php endif; ?>
    <?php endforeach; ?>
<?php endforeach; ?>
