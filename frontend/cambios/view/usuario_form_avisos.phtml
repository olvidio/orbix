<script>
    fnjs_mod_cambio = function (formulario) {
        rta = fnjs_solo_uno(formulario);
        if (rta === 1) {
            $('#av_salida').val('modificar');
            $(formulario).attr('action', 'frontend/cambios/controller/usuario_avisos_pref.php');
            fnjs_enviar_formulario(formulario);
        }
    }
    fnjs_del_cambio = function (formulario, que_val) {
        rta = fnjs_solo_uno(formulario);
        if (rta === 1) {
            if (confirm(<?= json_encode(_("¿Está seguro que desea borrar este aviso?")) ?>)) {
                var ctx_eliminar = fnjs_ctx_fila_seleccionada(formulario, 'ctx_eliminar');
                if (!ctx_eliminar) {
                    alert(<?= json_encode(_("respuesta") . ": ") ?> + <?= json_encode(_("Operación no autorizada")) ?>);
                    return;
                }
                fnjs_ajax_json({
                    url: <?= json_encode($url_eliminar_aviso) ?>,
                    data: 'ctx_eliminar=' + encodeURIComponent(ctx_eliminar),
                    onSuccess: function () {
                        fnjs_enviar_formulario('#avisos');
                    }
                });
            }
        }
    }
    fnjs_add_cambio = function () {
        $('#av_salida').val('nuevo');
        $('#avisos').attr('action', "frontend/cambios/controller/usuario_avisos_pref.php");
        fnjs_enviar_formulario('#avisos');
    }
</script>
