<script>
    fnjs_modificar = function (formulario) {
        rta = fnjs_solo_uno(formulario);
        if (rta === 1) {
            $(formulario).attr('action', "frontend/menus/controller/grupmenu_form.php");
            fnjs_enviar_formulario(formulario);
        }
    }
    fnjs_eliminar = function (formulario) {
        rta = fnjs_solo_uno(formulario);
        if (rta === 1) {
            if (confirm(<?= json_encode(_("¿Está seguro que desea borrar este grupmenu?")) ?>)) {
                var ctx_eliminar = fnjs_ctx_fila_seleccionada(formulario, 'ctx_eliminar');
                if (!ctx_eliminar) {
                    alert(<?= json_encode(_("respuesta") . ": ") ?> + <?= json_encode(_("Operación no autorizada")) ?>);
                    return;
                }
                let url = '<?= AppUrlConfig::srcBrowserUrl('/src/menus/grupmenu_eliminar') ?>';
                let datos = 'ctx_eliminar=' + encodeURIComponent(ctx_eliminar);
                let request = $.ajax({
                    data: datos,
                    url: url,
                    method: 'POST',
                    dataType: 'json'
                });
                request.done(function (json) {
                    if (json.success !== true) {
                        alert(<?= json_encode(_("respuesta")) ?> + ': ' + json.mensaje);
                    } else {
                        fnjs_actualizar();
                    }
                });
            }
        }
    }
    fnjs_actualizar = function () {
        let url = '<?= HashF::link(AppUrlConfig::getPublicAppBaseUrl() . '/frontend/menus/controller/grupmenu_lista.php') ?>';
        fnjs_update_div('#main', url);
    }
    fnjs_left_side_hide();
</script>
