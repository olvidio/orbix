<style>
<!--
table { border:none; }
td { border:none; }
-->
</style>
{% block scripts %}
<script>
fnjs_generar_proceso=function(){
	if (confirm("{{ txt_confirm }}") ) {
		var url = "{{ url_generar }}";
		var parametros="{{ param_generar|raw }}";
		$.ajax({
			url: url,
			type: 'post',
			data: parametros,
			dataType: 'json'
		})
		.done(function (json) {
			if (json && json.success === false && json.mensaje) {
				alert('{{ "respuesta"|trans }}: ' + json.mensaje);
			}
		})
		.always(function () {
			fnjs_actualizar();
		});
	}
}

fnjs_actualizar=function(){
	var id_activ=$('#id_activ').val();
	/* obtener el listado de fases */
	var url = "{{ url_get }}";
	var parametros="{{ param_actualizar|raw }}";
		 
	fnjs_ajax_json_html({ url: url, data: parametros, target: '#div_proceso' });
}

fnjs_guardar=function(id_item, ctx){
	var force=$('#force').prop("checked");
	var completado=$('#comp'+id_item).prop('checked');
	var observ=$('#observ'+id_item).val();
	var url = "{{ url_update }}";
	// La observación va codificada: con «&», «+» o «#» el servidor recibía otros campos y rechazaba la petición.
	var parametros='ctx_update='+encodeURIComponent(ctx)+'&completado='+completado+'&force='+force+'&observ='+encodeURIComponent(observ === undefined ? '' : observ)+'{{ h_update|raw }}';
		 
	$.ajax({
		url: url,
		type: 'post',
		data: parametros,
		dataType: 'json'
	})
	.done(function (json) {
		if (json && json.success === false && json.mensaje) {
			alert('{{ "respuesta"|trans }}: ' + json.mensaje);
		}
	})
	// Repintar cuando el servidor ha contestado (antes se pedía la tabla a la vez que se guardaba
	// y podía pintarse el estado anterior).
	.always(function () {
		fnjs_actualizar();
	});
}
fnjs_actualizar();
</script>
{% endblock %}
{% block arrow %}
{{ oPosicion.mostrarNavAtras(1)|raw }}
{% endblock %}
<div id="exportar" export_modo="formulario">
{% block head %}
<table><tr>
	<td>
	<span class="link" onclick="fnjs_update_div('#main','{{ godossiers }}');" ><img src="{{ web_icons}}/dossiers.gif" border=0 width=40 height=40 alt="{{ alt }}">({{ dos }})</span>
	</td>
	<td class=titulo>{{ nom_activ }}</td>
	</tr></table>
{% endblock %}
{% block body %}
<table>
<input type='Hidden' id='que' name='que' value=''>
<tr><th colspan='5' class=titulo_inv>{{ "fases de la actividad"|trans|capitalize }}</th>
{% if permiso_calendario %}
	<td><input type="Button" value="{{ "regenerar"|trans|raw }}" onclick="fnjs_generar_proceso()"></td>
{% endif %}
<td style="text-align: right;">{{ "forzar"|trans|raw }}<input type="checkbox" name=force id=force></td>
</tr>
</table>

<div id='div_proceso'></div>
<input type='button' name='b_nuevo' value='{{ "actualizar"|trans|raw }}' onclick='fnjs_actualizar();'>
<div id='div_modificar'></div>
<div id='resto'></div>
{% endblock %}
</div>
