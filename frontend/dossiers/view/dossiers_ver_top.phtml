<?php
/**
 * Cabecera (`top`) de `dossiers_ver`. Recibe URLs ya firmadas desde el controlador.
 *
 * @var string $web_icons
 * @var string $alt_dossiers
 * @var string $txt_dossiers
 * @var string $nom_cabecera
 * @var string $go_dossiers   URL ya firmada (HashF) para volver a la relación de dossiers.
 * @var string $go_home       URL ya firmada (HashF) para volver al "home" del sujeto (p/u/a).
 */
?>
<div id="top">
    <table>
        <tr>
            <td>
                <span class="link" onclick="fnjs_update_div('#main','<?= htmlspecialchars((string) $go_dossiers, ENT_QUOTES, 'UTF-8') ?>')">
                    <img src="<?= htmlspecialchars((string) $web_icons, ENT_QUOTES, 'UTF-8') ?>/dossiers.gif" width="40" height="40"
                         alt="<?= htmlspecialchars($alt_dossiers, ENT_QUOTES, 'UTF-8') ?>">(
                    <?= htmlspecialchars((string) $txt_dossiers, ENT_QUOTES, 'UTF-8') ?> )
                </span>
            </td>
            <td class="titulo">
                <?php if ($go_home !== ''): ?>
                    <span class="link" onclick="fnjs_update_div('#main','<?= htmlspecialchars((string) $go_home, ENT_QUOTES, 'UTF-8') ?>')"><?= htmlspecialchars((string) $nom_cabecera, ENT_QUOTES, 'UTF-8') ?></span>
                <?php else: ?>
                    <?= htmlspecialchars((string) $nom_cabecera, ENT_QUOTES, 'UTF-8') ?>
                <?php endif; ?>
            </td>
        </tr>
    </table>
</div>
