<?php

use frontend\shared\config\OrbixRuntime;

$iconsBase = (string)($web_icons ?? OrbixRuntime::getWebIcons());
$a_filas = is_array($a_filas ?? null) ? $a_filas : [];
?>
<table border="1" aria-describedby="relación de dossiers">
    <tr>
        <th scope="col" colspan=2>
            <h2 class="titulo_inv"><?= ucfirst(_("relación de dossiers")); ?></h2>
        </th>
    </tr>
    <?php
    $pencil = $iconsBase . '/pencil.png';
    $eye = $iconsBase . '/eye.png';
    $deny = $iconsBase . '/deny.png';
    foreach ($a_filas as $fila) {
        $perm_a = (int)($fila['perm_a'] ?? 0);
        ?>
        <tr class="<?= htmlspecialchars((string) ($fila['clase'] ?? ''), ENT_QUOTES, 'UTF-8') ?>">
            <?php
            switch ($perm_a) {
                case 1: //no tiene permisos
                    ?>
                    <td><img class="dossier" src='<?= htmlspecialchars((string) $fila['imagen'], ENT_QUOTES, 'UTF-8') ?>' alt="<?= _("dossier sin permisos") ?>"></td>
                    <td><?= htmlspecialchars((string) $fila['descripcion'], ENT_QUOTES, 'UTF-8') ?>
                        <img class="dossier" src='<?= htmlspecialchars((string) $deny, ENT_QUOTES, 'UTF-8') ?>' alt="<?= _("dossier sin permisos") ?>">
                    </td>
                    <?php break;
                case 2: // sólo lectura
                    ?>
                    <td><img class="dossier" src='<?= htmlspecialchars((string) $fila['imagen'], ENT_QUOTES, 'UTF-8') ?>' alt="<?= _("dossier de sólo lectura") ?>">
                    </td>
                    <td><span class="link" onclick="fnjs_update_div('#main','<?= htmlspecialchars((string) ($fila['href_ver'] ?? ''), ENT_QUOTES, 'UTF-8') ?>');">
				<span style="color:green"><?= htmlspecialchars((string) $fila['descripcion'], ENT_QUOTES, 'UTF-8') ?></span>
			    <img class="dossier" src='<?= htmlspecialchars((string) $eye, ENT_QUOTES, 'UTF-8') ?>' alt="<?= _("dossier de sólo lectura") ?>">
			</span></td>
                    <?php break;
                case 3: //lectura y escritura
                    ?>
                    <td><img class="dossier" src='<?= htmlspecialchars((string) $fila['imagen'], ENT_QUOTES, 'UTF-8') ?>' alt="<?= _("dossier modificable") ?>"></td>
                    <td><span class="link" onclick="fnjs_update_div('#main','<?= htmlspecialchars((string) ($fila['href_ver'] ?? ''), ENT_QUOTES, 'UTF-8') ?>');">
				<?= htmlspecialchars((string) $fila['descripcion'], ENT_QUOTES, 'UTF-8') ?>
			    <img class="dossier" src='<?= htmlspecialchars((string) $pencil, ENT_QUOTES, 'UTF-8') ?>' alt="<?= _("dossier modificable") ?>">
			</span></td>
                    <?php break;
                default:
                    ?>
                    <td><img class="dossier" src='<?= htmlspecialchars((string) ($fila['imagen'] ?? ''), ENT_QUOTES, 'UTF-8') ?>' alt=""></td>
                    <td><?= htmlspecialchars((string) ($fila['descripcion'] ?? ''), ENT_QUOTES, 'UTF-8') ?></td>
                    <?php
                    break;
            }
            ?>
        </tr>
        <?php
    }
    ?>
</table>
