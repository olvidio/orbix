<?php
$ctr = 0;
foreach ($aCentros as $Centro) {
    $ctr++;
    $nombre_ubi = $Centro['nombre_ubi'];
    $aPersonasCtr = $Centro['personas'];
    ?>
    <div class='salta_pag'>
        <table>
            <tr>
                <th colspan=4><?= htmlspecialchars((string) $nombre_ubi, ENT_QUOTES, 'UTF-8') ?></th>
            </tr>
            <tr>
                <th><?= _("nombre") ?></th>
                <th><?= _("actividades previstas") ?></th>
            </tr>
            <?php
            foreach ($aPersonasCtr as $Persona) {
                $ap_nom = $Persona['ap_nom'];
                $aActividades = $Persona['actividades'];
                if (empty($aActividades)) {
                    $actividades_txt = _("pendiente de solicitar");
                    $clase = 'alert';
                } else {
                    $clase = '';
                    $actividades_txt = '';
                    foreach ($aActividades as $actividad) {
                        $actividades_txt .= empty($actividades_txt) ? '' : '<br>';
                        $actividades_txt .= $actividad;
                    }
                }
                ?>
                <tr valign="TOP">
                    <td><?= htmlspecialchars((string) $ap_nom, ENT_QUOTES, 'UTF-8') ?></td>
                    <td class="<?= htmlspecialchars((string) $clase, ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars((string) $actividades_txt, ENT_QUOTES, 'UTF-8') ?></td>
                </tr>
                <?php
            }
            ?>
        </table>
    </div>
    <?php
}
