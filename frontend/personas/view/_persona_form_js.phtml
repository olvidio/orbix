<?php

/**
 * Fragmento JS compartido por `persona_form.phtml`, `persona_sss_form.phtml`
 * y `persona_de_paso.phtml`: define `fnjs_guardar` / `fnjs_eliminar` llamando
 * a los endpoints JSON `/src/personas/persona_update` y `/src/personas/persona_eliminar`.
 *
 * Variables esperadas:
 *   - `$oPosicion` (frontend\shared\web\Posicion)
 */
use frontend\shared\config\AppUrlConfig;
?>
<script>
    fnjs_act_ctr = function (camp) {
        var idCamp = '#id_' + camp;
        var centre = $(idCamp).val();
        $(camp).val(centre);
    }

    fnjs_guardar = function (formulario) {
        var $form = $(formulario);
        var apellido1 = ($form.find('[name="apellido1"]').val() || '').toString().trim();
        if (apellido1 === '') {
            alert(<?= json_encode(_("debe indicar el apellido")) ?>);
            $form.find('[name="apellido1"]').trigger('focus');
            return;
        }
        $.ajax({
            type: 'post',
            url: <?= json_encode(AppUrlConfig::srcBrowserUrl('/src/personas/persona_update')) ?>,
            data: $form.serialize(),
            dataType: 'json'
        }).done(function (json) {
            if (json.success !== true) {
                alert(<?= json_encode(_("respuesta") . ": ") ?> + (json.mensaje || ''));
            } else {
                <?= $oPosicion->jsNavAtras(1); ?>
            }
        }).fail(function (xhr, status, error) {
            var mensaje = '';
            try {
                var parsed = xhr.responseJSON || JSON.parse(xhr.responseText);
                if (parsed && parsed.mensaje) {
                    mensaje = parsed.mensaje;
                }
            } catch (e) {}
            alert(<?= json_encode(_("Error en la conexión con el servidor")) ?> + ': ' + (mensaje || error));
        });
    }

    fnjs_eliminar = function (formulario) {
        if (confirm(<?= json_encode(_("¿Está seguro que desea borrar esta persona?")) ?>)) {
            $.ajax({
                url: <?= json_encode(AppUrlConfig::srcBrowserUrl('/src/personas/persona_eliminar')) ?>,
                type: 'post',
                data: $(formulario).serialize(),
                dataType: 'json'
            }).done(function (json) {
                if (json.success !== true) {
                    alert(<?= json_encode(_("respuesta") . ": ") ?> + (json.mensaje || ''));
                } else {
                    <?= $oPosicion->jsNavAtras(1); ?>
                }
            }).fail(function (xhr, status, error) {
                var mensaje = '';
                try {
                    var parsed = xhr.responseJSON || JSON.parse(xhr.responseText);
                    if (parsed && parsed.mensaje) {
                        mensaje = parsed.mensaje;
                    }
                } catch (e) {}
                alert(<?= json_encode(_("Error en la conexión con el servidor")) ?> + ': ' + (mensaje || error));
            });
        }
    }
</script>
