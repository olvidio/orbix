<?php
use frontend\shared\config\AppUrlConfig;
?>
<script>
    fnjs_guardar_publicar = function (formulario) {
        if ($(formulario).find('[name=dl]').val() === '') {
            alert(<?= json_encode(_("Debe elegir una delegación")) ?>);
            return;
        }
        $.ajax({
            data: $(formulario).serialize(),
            url: '<?= AppUrlConfig::srcBrowserUrl('/src/personas/persona_publicar') ?>',
            method: 'POST',
            dataType: 'json'
        }).done(function (json) {
            if (json.success !== true) {
                alert(<?= json_encode(_("respuesta")) ?> + ': ' + json.mensaje);
            } else {
                alert(<?= json_encode(_("persona publicada")) ?>);
                <?= $oPosicion->jsNavAtras(1); ?>
            }
        });
    }
</script>
<?= $oPosicion->mostrarNavAtras(1); ?>
<h2 class="titulo"><?= ucfirst(_("publicar persona")) ?></h2>
<p class="comentario"><?= _("La persona quedará visible en el desplegable de la DL destino durante un mes.") ?></p>
<form id="frm_publicar" name="frm_publicar" action="" method="POST">
    <?= $oHash->getCamposHtml(); ?>
    <table>
        <tr>
            <th class="etiqueta_inv"><?= htmlspecialchars((string) $nom, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); ?></th>
            <td class="datos">
                <?= $oDespl->desplegable(); ?>
            </td>
        </tr>
    </table>
    <input type="button" id="guardar" name="guardar" onclick="fnjs_guardar_publicar('#frm_publicar');"
           value="<?= htmlspecialchars(ucfirst(_("publicar")), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>">
</form>
