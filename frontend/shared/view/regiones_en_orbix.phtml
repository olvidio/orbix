<?php

use frontend\shared\helpers\RegionesEnOrbix;

/** @var string $hashParamsRegiones */

$regionTodos = htmlspecialchars(RegionesEnOrbix::codigoTodos(), ENT_QUOTES, 'UTF-8');
?>
<div id="lista_regiones">
<br>
<h3><?= _('Regiones o delegaciones que usan este programa actualmente') ?></h3>
<table style="width:50%">
   <tr><th><?= _('sigla') ?></th><th><?= _('región o dl') ?></th><th><?= _('usuarios') ?></th></tr>
<?php foreach (RegionesEnOrbix::bloques() as $i => $filas) : ?>
<?php if ($i > 0) : ?>
   <tr><td>--</td></tr>
<?php endif; ?>
<?php foreach ($filas as $fila) : ?>
   <tr>
       <td><?= htmlspecialchars($fila['sigla'], ENT_QUOTES, 'UTF-8') ?></td>
       <td><?= htmlspecialchars($fila['nombre'], ENT_QUOTES, 'UTF-8') ?></td>
       <td><span class="link" onclick="fnjs_mostrar_modal('<?= htmlspecialchars($fila['codigo'], ENT_QUOTES, 'UTF-8') ?>')"><?= _('ver contactos') ?></span></td>
   </tr>
<?php endforeach; ?>
<?php endforeach; ?>
   <tr><td>--</td></tr>
    <tr><td>todos</td><td><?= _('lista de todos') ?></td><td><span class="link" onclick="fnjs_mostrar_modal('<?= $regionTodos ?>')"><?= _('ver todos los contactos') ?></span></td></tr>
</table>
</div>

<div id="div_modal" style="display: none">
    <div id="div_cerrar">
        <span class="link" onclick="fnjs_cerrar()" style="float: right; margin-bottom: 5px;">
            <?= _('Cerrar') ?> [x]
        </span>
    </div>
    <div id="div_modificar5"></div>
</div>
<div id="overlay"></div>

<script type="application/javascript">
    fnjs_cerrar = function () {
        $('#div_modificar5').html('');
        $('#div_modal').width('0');
        $('#div_modal').height('0');
        $('#div_modal').removeClass('ventana');
        document.getElementById("overlay").style.display = "none";
        document.getElementById("div_modal").style.display = "none";
    };

    fnjs_mostrar_modal = function (region) {
        fnjs_ajax_json_html({
            url: 'frontend/usuarios/controller/mails_contactos_region.php',
            data: {
              <?= $hashParamsRegiones ?>,
              region: region
            },
            target: '#div_modificar5',
            onDone: function () {
                // la ventana es #div_modal (el target ajax es un div interior)
                fnjs_ventana_ajustar('#div_modal');
            }
        });

        $('#div_modal').addClass('ventana');
        $('#div_modal').width('auto');
        $('#div_modal').height('auto');
        document.getElementById("overlay").style.display = "block";
        document.getElementById("div_modal").style.display = "block";
    };
</script>
