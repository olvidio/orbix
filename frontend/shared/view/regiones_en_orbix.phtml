<div id="div_modal" style="display: none">
    <div id="div_cerrar">
        <button type="button" class="ventana-icon-btn" id="btn_copiar_modal"
                title="<?= htmlspecialchars(_('Copiar'), ENT_QUOTES, 'UTF-8') ?>"
                aria-label="<?= htmlspecialchars(_('Copiar'), ENT_QUOTES, 'UTF-8') ?>"
                onclick="fnjs_copiar_contenido_modal(); return false;">
            <svg class="ventana-icon-copy" viewBox="0 0 16 16" aria-hidden="true">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/>
                <path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" fill="none" stroke="currentColor" stroke-width="1.4"/>
            </svg>
            <svg class="ventana-icon-check" viewBox="0 0 16 16" aria-hidden="true" style="display:none">
                <path d="M3.5 8.5l3 3 6-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        <span class="link" onclick="fnjs_cerrar()">
            <?= _('Cerrar') ?> [x]
        </span>
    </div>
    <div id="div_modificar5"></div>
</div>
<div id="overlay"></div>

<script type="application/javascript">
    var _orbixCopiaModalTimer = null;

    fnjs_cerrar = function () {
        $('#div_modificar5').html('');
        $('#div_modal').width('0');
        $('#div_modal').height('0');
        $('#div_modal').removeClass('ventana');
        document.getElementById("overlay").style.display = "none";
        document.getElementById("div_modal").style.display = "none";
        fnjs_copiar_modal_reset_icono();
    };

    fnjs_copiar_modal_reset_icono = function () {
        var $btn = $('#btn_copiar_modal');
        $btn.find('.ventana-icon-copy').show();
        $btn.find('.ventana-icon-check').hide();
        $btn.attr('title', <?= json_encode(_('Copiar'), JSON_UNESCAPED_UNICODE) ?>);
        $btn.attr('aria-label', <?= json_encode(_('Copiar'), JSON_UNESCAPED_UNICODE) ?>);
        if (_orbixCopiaModalTimer) {
            clearTimeout(_orbixCopiaModalTimer);
            _orbixCopiaModalTimer = null;
        }
    };

    fnjs_copiar_modal_ok = function () {
        var $btn = $('#btn_copiar_modal');
        $btn.find('.ventana-icon-copy').hide();
        $btn.find('.ventana-icon-check').show();
        $btn.attr('title', <?= json_encode(_('Copiado'), JSON_UNESCAPED_UNICODE) ?>);
        $btn.attr('aria-label', <?= json_encode(_('Copiado'), JSON_UNESCAPED_UNICODE) ?>);
        if (_orbixCopiaModalTimer) {
            clearTimeout(_orbixCopiaModalTimer);
        }
        _orbixCopiaModalTimer = setTimeout(fnjs_copiar_modal_reset_icono, 1600);
    };

    fnjs_copiar_texto = function (texto, onOk) {
        if (!texto) {
            return;
        }
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(texto).then(onOk).catch(function () {
                fnjs_copiar_texto_fallback(texto, onOk);
            });
            return;
        }
        fnjs_copiar_texto_fallback(texto, onOk);
    };

    fnjs_copiar_texto_fallback = function (texto, onOk) {
        var ta = document.createElement('textarea');
        ta.value = texto;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        try {
            if (document.execCommand('copy') && typeof onOk === 'function') {
                onOk();
            }
        } finally {
            document.body.removeChild(ta);
        }
    };

    fnjs_copiar_contenido_modal = function () {
        var nodo = document.getElementById('div_modificar5');
        var texto = nodo ? (nodo.innerText || '').replace(/\n{3,}/g, '\n\n').trim() : '';
        fnjs_copiar_texto(texto, fnjs_copiar_modal_ok);
    };

    fnjs_mostrar_modal = function (region) {
        fnjs_ajax_json_html({
            url: 'frontend/usuarios/controller/mails_contactos_region.php',
            data: {
              <?= $hashParamsRegiones ?>,
              region: region
            },
            target: '#div_modificar5',
            onDone: function () {
                // la ventana es #div_modal (el target ajax es un div interior)
                fnjs_ventana_ajustar('#div_modal');
            }
        });

        fnjs_copiar_modal_reset_icono();
        $('#div_modal').addClass('ventana');
        $('#div_modal').width('auto');
        $('#div_modal').height('auto');
        document.getElementById("overlay").style.display = "block";
        document.getElementById("div_modal").style.display = "block";
    };
</script>
