<?php
/**
 * Botón «?» + panel lateral de ayuda contextual (se incluye desde index.php, fuera de #main).
 *
 * @var string $urlAyudaPantalla endpoint /src/shared/ayuda_pantalla (vía src_ajax)
 * @var string $hashAyudaPantalla pares 'h':'…' de HashF para ese endpoint (literal JS)
 * @var string $urlManual frontend/shared/controller/manual.php
 * @var string $urlPreguntar frontend/shared/controller/ayuda_preguntar.php
 * @var int $limiteTareas
 */
?>
<style>
    #ayuda_ctx_btn { position: fixed; right: 1rem; bottom: 1rem; z-index: 99990; width: 2.25rem; height: 2.25rem;
        border-radius: 50%; border: 1px solid #5b6b7b; background: #fff; color: #2c3e50; font: bold 1.1rem/1 sans-serif;
        cursor: pointer; box-shadow: 0 1px 4px rgba(0, 0, 0, .3); padding: 0; }
    #ayuda_ctx_btn:hover, #ayuda_ctx_btn:focus { background: #eaf1f8; }
    #ayuda_ctx_btn[hidden], #ayuda_ctx_panel[hidden] { display: none; }
    #ayuda_ctx_panel { position: fixed; top: 0; right: 0; bottom: 0; z-index: 99995; width: min(24rem, 100vw);
        background: #fff; border-left: 1px solid #c5ced8; box-shadow: -2px 0 8px rgba(0, 0, 0, .2);
        display: flex; flex-direction: column; font-size: .95rem; line-height: 1.4; color: #1a1a1a; }
    #ayuda_ctx_panel header { display: flex; align-items: flex-start; gap: .5rem; padding: .75rem .9rem;
        border-bottom: 1px solid #e1e6eb; background: #f4f6f8; }
    #ayuda_ctx_panel header h2 { margin: 0; font-size: 1.05rem; flex: 1 1 auto; }
    #ayuda_ctx_panel header button { border: 0; background: none; font-size: 1.4rem; line-height: 1; cursor: pointer; }
    #ayuda_ctx_cuerpo { flex: 1 1 auto; overflow-y: auto; padding: .75rem .9rem; }
    #ayuda_ctx_cuerpo h3 { font-size: .85rem; text-transform: uppercase; letter-spacing: .03em; color: #5b6b7b; margin: .25rem 0 .4rem; }
    #ayuda_ctx_cuerpo ul { list-style: none; margin: 0; padding: 0; }
    #ayuda_ctx_cuerpo li { margin: 0 0 .7rem; }
    #ayuda_ctx_cuerpo li small { display: block; color: #555; }
    #ayuda_ctx_cuerpo a { cursor: pointer; }
    #ayuda_ctx_pie { padding: .6rem .9rem; border-top: 1px solid #e1e6eb; display: flex; gap: .75rem; flex-wrap: wrap; }
    #ayuda_ctx_estado { color: #555; }
</style>
<button type="button" id="ayuda_ctx_btn" hidden
        aria-label="<?= htmlspecialchars(_("Ayuda"), ENT_QUOTES, 'UTF-8') ?>"
        title="<?= htmlspecialchars(_("Ayuda"), ENT_QUOTES, 'UTF-8') ?>">?</button>
<aside id="ayuda_ctx_panel" hidden role="complementary" aria-labelledby="ayuda_ctx_titulo">
    <header>
        <h2 id="ayuda_ctx_titulo"><?= _("Ayuda") ?></h2>
        <button type="button" id="ayuda_ctx_cerrar" aria-label="<?= htmlspecialchars(_("Cerrar"), ENT_QUOTES, 'UTF-8') ?>">×</button>
    </header>
    <div id="ayuda_ctx_cuerpo" aria-live="polite"></div>
    <div id="ayuda_ctx_pie"></div>
</aside>
<script>
    (function () {
        var URL_AYUDA = <?= json_encode($urlAyudaPantalla) ?>;
        var HASH = { <?= $hashAyudaPantalla ?> };
        var URL_MANUAL = <?= json_encode($urlManual) ?>;
        var URL_PREGUNTAR = <?= json_encode($urlPreguntar) ?>;
        var LIMITE = <?= (int)$limiteTareas ?>;
        var T = {
            ayuda: <?= json_encode(_("Ayuda")) ?>,
            cargando: <?= json_encode(_("Cargando...")) ?>,
            error: <?= json_encode(_("No se ha podido cargar la ayuda.")) ?>,
            tareas: <?= json_encode(_("Tareas habituales")) ?>,
            verTodas: <?= json_encode(_("Ver las %d tareas en el manual")) ?>,
            manual: <?= json_encode(_("Abrir el manual")) ?>,
            preguntar: <?= json_encode(_("Preguntar a la ayuda")) ?>
        };
        // Pantallas de la propia ayuda: no tiene sentido ofrecer ayuda sobre la ayuda.
        var RE_AYUDA = /(frontend\/shared\/controller\/(manual|ayuda_index|ayuda_preguntar)\.php|public\/ayuda\/)/;

        var btn = document.getElementById('ayuda_ctx_btn');
        var panel = document.getElementById('ayuda_ctx_panel');
        var titulo = document.getElementById('ayuda_ctx_titulo');
        var cuerpo = document.getElementById('ayuda_ctx_cuerpo');
        var pie = document.getElementById('ayuda_ctx_pie');
        var main = document.getElementById('main');
        if (!btn || !panel || !main) {
            return;
        }
        var peticion = 0;

        function refe() {
            return (main.getAttribute('refe') || '').toString();
        }

        function esPantallaDeAyuda() {
            return RE_AYUDA.test(refe());
        }

        function irA(url, params) {
            if (typeof fnjs_link_submenu === 'function') {
                fnjs_link_submenu(url, params);
            } else {
                window.location.href = url + '?' + params;
            }
        }

        function enlace(texto, url, params) {
            var a = document.createElement('a');
            a.className = 'link nohref';
            a.href = '#';
            a.textContent = texto;
            a.addEventListener('click', function (ev) {
                ev.preventDefault();
                irA(url, params);
            });
            return a;
        }

        function pintar(d) {
            cuerpo.textContent = '';
            pie.textContent = '';
            titulo.textContent = d.encontrada && d.titulo ? d.titulo : T.ayuda;

            if (!d.encontrada) {
                var p = document.createElement('p');
                p.textContent = d.aviso_txt || '';
                cuerpo.appendChild(p);
            } else {
                var h3 = document.createElement('h3');
                h3.textContent = T.tareas;
                cuerpo.appendChild(h3);
                var ul = document.createElement('ul');
                (d.tareas || []).forEach(function (t) {
                    var li = document.createElement('li');
                    li.appendChild(enlace(t.titulo, URL_MANUAL,
                        'modulo=' + encodeURIComponent(t.modulo) + '&ancla=' + encodeURIComponent(t.ancla)));
                    if (t.sirve) {
                        var s = document.createElement('small');
                        s.textContent = t.sirve;
                        li.appendChild(s);
                    }
                    ul.appendChild(li);
                });
                cuerpo.appendChild(ul);
                if ((d.total_tareas || 0) > (d.tareas || []).length && d.manual_modulo) {
                    var pTodas = document.createElement('p');
                    pTodas.appendChild(enlace(T.verTodas.replace('%d', String(d.total_tareas)), URL_MANUAL,
                        'modulo=' + encodeURIComponent(d.manual_modulo)));
                    cuerpo.appendChild(pTodas);
                }
            }
            if (d.manual_modulo) {
                pie.appendChild(enlace(T.manual, URL_MANUAL, 'modulo=' + encodeURIComponent(d.manual_modulo)));
            } else {
                pie.appendChild(enlace(T.manual, URL_MANUAL, ''));
            }
            pie.appendChild(enlace(T.preguntar, URL_PREGUNTAR, ''));
        }

        function pintarError() {
            titulo.textContent = T.ayuda;
            cuerpo.textContent = '';
            var p = document.createElement('p');
            p.textContent = T.error;
            cuerpo.appendChild(p);
        }

        function cargar() {
            var id = ++peticion;
            titulo.textContent = T.ayuda;
            cuerpo.textContent = T.cargando;
            pie.textContent = '';

            var body = new URLSearchParams();
            Object.keys(HASH).forEach(function (k) { body.append(k, HASH[k]); });
            body.append('controller', refe());
            body.append('limite', String(LIMITE));

            fetch(URL_AYUDA, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: body.toString(),
                credentials: 'same-origin'
            }).then(function (resp) {
                return resp.json();
            }).then(function (rta) {
                if (id !== peticion) { return; }
                if (!rta || rta.success !== true) { pintarError(); return; }
                var data = rta.data;
                if (typeof data === 'string') {
                    try { data = JSON.parse(data); } catch (e) { pintarError(); return; }
                }
                if (!data || typeof data !== 'object') { pintarError(); return; }
                pintar(data);
            }).catch(function () {
                if (id === peticion) { pintarError(); }
            });
        }

        // Algunos layouts tienen barras fijas (menús) que quedan por encima del panel pese al z-index:
        // se busca la primera altura en la que el panel es realmente visible y se coloca ahí.
        function ajustarTop() {
            panel.style.top = '0px';
            var x = Math.max(window.innerWidth - 20, 0);
            for (var y = 0; y <= 300; y += 4) {
                var el = document.elementFromPoint(x, y);
                if (el && panel.contains(el)) {
                    panel.style.top = y + 'px';
                    return;
                }
            }
        }

        function abrir() {
            panel.hidden = false;
            ajustarTop();
            cargar();
        }

        function cerrar() {
            panel.hidden = true;
            peticion++;
        }

        function actualizarVisibilidad() {
            var ocultar = esPantallaDeAyuda();
            btn.hidden = ocultar;
            if (ocultar) {
                cerrar();
            } else if (!panel.hidden) {
                cargar(); // El usuario ha cambiado de pantalla con el panel abierto.
            }
        }

        btn.addEventListener('click', function () {
            if (panel.hidden) { abrir(); } else { cerrar(); }
        });
        document.getElementById('ayuda_ctx_cerrar').addEventListener('click', cerrar);
        document.addEventListener('keydown', function (ev) {
            if (ev.key === 'Escape' && !panel.hidden) { cerrar(); }
        });

        // `refe` cambia cada vez que se carga una pantalla en #main (menús, enlaces, formularios).
        new MutationObserver(actualizarVisibilidad).observe(main, { attributes: true, attributeFilter: ['refe'] });
        actualizarVisibilidad();
    })();
</script>
