<script type="application/javascript">
    fnjs_ayuda_nav = function (fullUrl, parametros, hrefFallback) {
        if (typeof fnjs_link_submenu === 'function' && document.getElementById('main')) {
            fnjs_link_submenu(fullUrl, parametros);
            return false;
        }
        if (hrefFallback) {
            window.location.href = hrefFallback;
        }
        return false;
    };

    fnjs_ayuda_parse_rta = function (rta) {
        if (!rta || rta.success !== true) {
            var msg = (rta && rta.mensaje) ? rta.mensaje : <?= json_encode(_('Error desconocido')) ?>;
            throw new Error(msg);
        }
        var data = rta.data;
        if (typeof data === 'string') {
            var trimmed = data.trim();
            if (trimmed.charAt(0) === '{' || trimmed.charAt(0) === '[') {
                data = JSON.parse(data);
            } else {
                data = {};
            }
        }
        return data || {};
    };

    fnjs_ayuda_preguntar = function () {
        var input = document.getElementById('ayuda_pregunta');
        var estado = document.getElementById('ayuda_preguntar_estado');
        var box = document.getElementById('ayuda_preguntar_resultados');
        var pregunta = (input && input.value ? input.value : '').toString().trim();
        if (pregunta === '') {
            alert(<?= json_encode(_('Escriba una pregunta.')) ?>);
            return false;
        }
        if (estado) {
            estado.textContent = <?= json_encode(_('Buscando…')) ?>;
            estado.className = 'comentario';
        }
        if (box) {
            box.innerHTML = '';
        }

        var body = new URLSearchParams();
        var hashParts = { <?= $hashPreguntar ?> };
        Object.keys(hashParts).forEach(function (k) {
            body.append(k, hashParts[k]);
        });
        body.append('pregunta', pregunta);
        body.append('limite', '8');

        fetch(<?= json_encode($urlPreguntar) ?>, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
            body: body.toString(),
            credentials: 'same-origin'
        }).then(function (resp) {
            return resp.json();
        }).then(function (rta) {
            if (estado) {
                estado.textContent = '';
            }
            fnjs_ayuda_pintar(fnjs_ayuda_parse_rta(rta));
        }).catch(function (err) {
            if (estado) {
                estado.className = 'comentario ayuda-error';
                estado.textContent = (err && err.message)
                    ? err.message
                    : <?= json_encode(_('Error al consultar la documentación.')) ?>;
            }
        });
        return false;
    };

    fnjs_ayuda_pintar = function (data) {
        var box = document.getElementById('ayuda_preguntar_resultados');
        if (!box) {
            return;
        }
        box.innerHTML = '';
        var respuesta = (data.respuesta || '').toString();
        if (respuesta !== '') {
            var divR = document.createElement('div');
            divR.className = 'ayuda-respuesta';
            divR.textContent = respuesta;
            box.appendChild(divR);
        }
        var resultados = data.resultados || [];
        if (!resultados.length) {
            return;
        }
        var manualUrl = <?= json_encode($manualBase) ?>;
        var labelManual = <?= json_encode(_('Manual')) ?>;
        var labelAi = <?= json_encode(_('Ayuda IA')) ?>;
        var labelAbrir = <?= json_encode(_('Abrir en el manual')) ?>;
        for (var i = 0; i < resultados.length; i++) {
            var r = resultados[i] || {};
            var hit = document.createElement('article');
            hit.className = 'ayuda-hit';
            var h3 = document.createElement('h3');
            h3.textContent = r.titulo || '';
            hit.appendChild(h3);
            var meta = document.createElement('div');
            meta.className = 'ayuda-meta';
            meta.textContent = (r.tipo === 'manual' ? labelManual : labelAi)
                + ' · ' + (r.modulo || '')
                + ' · ' + (r.fuente || '');
            hit.appendChild(meta);
            var excerpt = document.createElement('p');
            excerpt.className = 'ayuda-excerpt';
            excerpt.textContent = r.excerpt || '';
            hit.appendChild(excerpt);
            if (r.tipo === 'manual' && r.modulo) {
                var p = document.createElement('p');
                var a = document.createElement('a');
                a.className = 'link nohref';
                a.href = '#';
                a.textContent = labelAbrir;
                a.setAttribute('data-modulo', r.modulo);
                a.addEventListener('click', function (ev) {
                    ev.preventDefault();
                    var slug = this.getAttribute('data-modulo') || '';
                    var params = 'modulo=' + encodeURIComponent(slug);
                    if (typeof fnjs_link_submenu === 'function' && document.getElementById('main')) {
                        fnjs_link_submenu(manualUrl, params);
                    } else {
                        window.location.href = manualUrl + '?' + params;
                    }
                    return false;
                });
                p.appendChild(a);
                hit.appendChild(p);
            }
            box.appendChild(hit);
        }
    };
</script>
<?= $oPosicion->mostrarNavAtras(1) ?>
