<script>
    fnjs_nuevo = function (formulario) {
        $('#mod').val("nuevo");
        $(formulario).attr('action', "frontend/configuracion/controller/modulos_form.php");
        fnjs_enviar_formulario(formulario);
    }
    fnjs_eliminar = function (formulario) {
        rta = fnjs_solo_uno(formulario);
        if (rta == 1) {
            if (confirm(<?= json_encode((string)$txt_eliminar) ?>)) {
                var ctx_eliminar = fnjs_ctx_fila_seleccionada(formulario, 'ctx_eliminar');
                if (!ctx_eliminar) {
                    alert(<?= json_encode(_("respuesta") . ": ") ?> + <?= json_encode(_("Operación no autorizada")) ?>);
                    return;
                }
                $('#mod').val("eliminar");
                $(formulario).attr('action', "frontend/configuracion/controller/modulos_update.php");
                $(formulario).one("submit", function () {
                    fnjs_ajax_json({
                        url: $(this).attr('action'),
                        data: $(this).serialize() + '&ctx_eliminar=' + encodeURIComponent(ctx_eliminar),
                        onSuccess: function () {
                            fnjs_actualizar(formulario);
                        }
                    });
                    return false;
                });
                $(formulario).trigger("submit");
                $(formulario).off();
            }
        }
    }
    fnjs_modificar = function (formulario) {
        rta = fnjs_solo_uno(formulario);
        if (rta == 1) {
            $(formulario).attr('action', "frontend/configuracion/controller/modulos_form.php");
            fnjs_enviar_formulario(formulario);
        }
    }
    fnjs_actualizar = function (formulario) {
        var campo = '<input type="hidden" name="refresh" value=1>';
        $(formulario).attr('action', "frontend/configuracion/controller/modulos_select.php");
        $(formulario).append(campo);
        fnjs_enviar_formulario(formulario, '#main');
    }
</script>
<h3>Modulos</h3>
<form id='seleccionados' name='seleccionados' action='' method='post'>
    <?= $hash_lista_html ?>
    <input type='hidden' id='mod' name='mod' value=''>
    <?= $oTabla->mostrar_tabla(); ?>
</form>
<br>
<table>
    <tr>
        <th class="no_print">
            <span class="link_inv"
                  onclick="fnjs_nuevo('#seleccionados');"><?= htmlspecialchars($txt_anadir_modulo, ENT_QUOTES) ?></span>
        </th>
    </tr>
</table>
