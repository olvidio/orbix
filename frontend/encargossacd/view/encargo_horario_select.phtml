<script>
    fnjs_modificar = function (formulario) {
        rta = fnjs_solo_uno(formulario);
        if (rta == 1) {
            $(formulario).attr('action', 'frontend/encargossacd/controller/horario_ver.php');
            fnjs_enviar_formulario(formulario);
        }
    }
    fnjs_borrar = function (formulario) {
        rta = fnjs_solo_uno(formulario);
        var seguro;
        if (rta == 1) {
            seguro = confirm(<?= json_encode((string)$txt_eliminar) ?>);
            if (seguro) {
                var ctx_eliminar = fnjs_ctx_fila_seleccionada(formulario, 'ctx_eliminar');
                if (!ctx_eliminar) {
                    alert(<?= json_encode(_("respuesta") . ": ") ?> + <?= json_encode(_("Operación no autorizada")) ?>);
                    return;
                }
                $(formulario).one("submit", function () {
                    var url = '<?= $url_borrar ?>';
                    var hExtra = '<?= $h_borrar ?>';
                    var parametros = 'mod=eliminar&ctx_eliminar=' + encodeURIComponent(ctx_eliminar) + hExtra;
                    $.ajax({
                        url: url,
                        type: 'post',
                        data: parametros,
                        dataType: 'json'
                    })
                        .done(function (json) {
                            if (!json || json.success !== true) {
                                alert(<?= json_encode(_("respuesta") . ": ") ?> + (json && json.mensaje ? json.mensaje : ''));
                                return;
                            }
                            fnjs_update_div('#main', '<?= $url_self ?>');
                        });
                    return false;
                });
                $(formulario).trigger("submit");
            }
        }
    }
</script>
