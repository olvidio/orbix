<?= $oPosicion->mostrarNavAtras(1) ?>
<script>
    fnjs_modificar = function (formulario) {
        rta = fnjs_solo_uno(formulario);
        if (rta === 1) {
            $(formulario).attr('action', "frontend/usuarios/controller/role_form.php");
            fnjs_enviar_formulario(formulario);
        }
    }
    fnjs_eliminar = function (formulario) {
        rta = fnjs_solo_uno(formulario);
        if (rta === 1) {
            if (confirm(<?= json_encode(_("¿Está seguro que desea borrar este rol?")) ?>)) {
                var ctx_eliminar = fnjs_ctx_fila_seleccionada(formulario, 'ctx_eliminar');
                if (!ctx_eliminar) {
                    alert(<?= json_encode(_("respuesta") . ": ") ?> + <?= json_encode(_("Operación no autorizada")) ?>);
                    return;
                }
                var url = '<?= AppUrlConfig::srcBrowserUrl('/src/usuarios/role_eliminar') ?>';
                let datos = 'ctx_eliminar=' + encodeURIComponent(ctx_eliminar);
                let request = $.ajax({
                    data: datos,
                    url: url,
                    method: 'POST',
                    dataType: 'json'
                });
                request.done(function (json) {
                    if (json.success !== true) {
                        alert(<?= json_encode(_("respuesta")) ?> + ': ' + json.mensaje);
                    } else {
                        fnjs_actualizar();
                    }
                });
            }
        }
    }
    fnjs_actualizar = function () {
        var url = '<?= HashF::link(AppUrlConfig::getPublicAppBaseUrl() . '/frontend/usuarios/controller/role_lista.php') ?>';
        fnjs_update_div('#main', url);
    }
    fnjs_left_side_hide();
</script>
<h1><?= _("listado de roles") ?></h1>
<p class="comentario">
    <?= _("Los roles son universales y solamente los puede modificar el superusuario.") ?>
    <br>
    <?= _("Los grupos de menus que se asignan a cada role son propios para cada dl (sv y sf distintos). Y los puede modificar el admin.") ?>
</p>
<br>
<form id="seleccionados" name="seleccionados" action="" method="post">
