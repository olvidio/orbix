<body>
    <div class="container">
        <h1><?= _("Recuperación del doble factor") ?></h1>

        <?php if ($estado === 'confirmar'): ?>
            <div class="message">
                <p><?= _("Se desactivará la autenticación de dos factores (2FA) de su usuario.") ?></p>
                <p><?= _("Después tendrá que iniciar sesión con su contraseña y configurar un doble factor nuevo.") ?></p>
                <form method="post" action="<?= htmlspecialchars((string)$url_accion, ENT_QUOTES, 'UTF-8') ?>">
                    <input type="hidden" name="token" value="<?= htmlspecialchars((string)$token, ENT_QUOTES, 'UTF-8') ?>">
                    <input type="hidden" name="id_usuario" value="<?= (int)$id_usuario ?>">
                    <input type="hidden" name="esquema" value="<?= htmlspecialchars((string)$esquema, ENT_QUOTES, 'UTF-8') ?>">
                    <button type="submit" id="btn_desactivar_2fa"><?= _("Desactivar el doble factor") ?></button>
                </form>
            </div>
        <?php elseif ($estado === 'desactivado'): ?>
            <div class="message success">
                <h2><?= _("El doble factor ha sido desactivado con éxito") ?></h2>
                <p><?= _("Inicie sesión con su contraseña y configure un doble factor nuevo en sus preferencias.") ?></p>
            </div>
        <?php else: ?>
            <div class="message error">
                <p><?= _("El enlace ha caducado o es inválido. Por favor, solicita uno nuevo") ?>.</p>
            </div>
        <?php endif; ?>

        <a href="<?= htmlspecialchars((string)$url_base, ENT_QUOTES) ?>" class="back-link"><?= _("Volver a la página de inicio") ?></a>
    </div>
</body>
</html>
