# Copiar este fichero como `.env` en la raíz del proyecto (`cp .env.example .env`).
# `.env` no debe subirse a git (contiene secretos).

# Directorio de ficheros `*.inc` (passwords/conexión) al ejecutar scripts CLI en el host
# (en Docker suele ser /var/www/conf montado desde docker_images/.../conf).
# ORBIX_DIR_PWD=/home/dani/docker_images/orbix/web/html/conf

# Sesión CLI para reconciliar copias (`src/shared/infrastructure/cli/copias_resincronizar.php`).
# Si no se pasa --sesion=, se busca ../conf/cron_sesion.inc (ver cron_sesion.inc.example).
# ORBIX_CRON_SESION=/home/dani/orbix_local/conf/cron_sesion.inc

# Firma de enlaces GET `tk` (frontend\shared\helpers\SignedDownloadToken).
# En producción usar al menos ~32 caracteres aleatorios (p. ej. `openssl rand -hex 32`).
ORBIX_SIGNED_DOWNLOAD_TOKEN_SECRET=

# Traducción asistida (`tools/i18n/traduir_groq.py`, `auditoria.py`)
# Clave en https://console.groq.com/keys
GROQ_API_KEY=

# Alternativa: `tools/i18n/traduir_gemini.py`
# Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Provisional: con `1`, una persona de paso se borra sin comprobar si tiene datos en otras dl
# (asistencias, cargos, encargos, notas…). Solo mientras en producción las dl no puedan leer las
# tablas madre; ver «Comprobación de datos al borrar una persona de paso» en docs/dev/backlog.md.
# ORBIX_PERSONA_DE_PASO_BORRAR_SIN_COMPROBAR=1

# Usuarios con rol de casa, centro o sacd (pau): con `exigir`, solo llegan a las pantallas y endpoints de
# src/shared/config/acceso_rol_pau.php. Sin ella solo se apunta lo que piden fuera de esa lista
# (log/acceso_pau_denegado.log), para completarla antes de exigir.
# ORBIX_ACCESO_PAU=exigir

# Firma `h` de HashF: por defecto una petición con datos y sin firma se rechaza (403).
# Con `aviso` no se corta, solo se apunta (para medir antes de exigir en una instalación).
# ORBIX_HASHF_SIN_FIRMA=aviso

# Caducidad de la sesión: minutos sin actividad (120 por defecto) y horas totales desde que se
# entró (12 por defecto). Pasado cualquiera de los dos límites hay que volver a entrar.
# ORBIX_SESION_INACTIVIDAD_MIN=120
# ORBIX_SESION_MAXIMA_HORAS=12
