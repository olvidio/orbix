<!-- para modificar por bloques -->
<p id="mod_bloque_mensaje" class="error" role="alert"
   style="display:none;color:#c00;font-weight:bold;margin:0.5em 0;"></p>
<script>

    fnjs_mod_bloque_mensaje = function (mensaje, esExito) {
        let $box = $('#mod_bloque_mensaje');
        if (!mensaje) {
            $box.hide().text('');
            return;
        }
        $box.text(mensaje).css('color', esExito ? '#060' : '#c00').show();
    };

    fnjs_mod_bloque_form_mensaje = function (formulario, mensaje) {
        let $form = $(formulario);
        let $err = $form.find('#frm_mod_bloque_mensaje');
        if (!$err.length) {
            $err = $('<p id="frm_mod_bloque_mensaje" role="alert"></p>').css({
                color: '#c00',
                fontWeight: 'bold',
                margin: '0 0 0.5em 0'
            });
            $form.prepend($err);
        }
        if (!mensaje) {
            $err.hide().text('');
            return;
        }
        $err.text(mensaje).show();
    };

    fnjs_cerrar = function () {
        fnjs_mod_bloque_form_mensaje('#frm_mod_bloque', '');
        $('#div_modificar').html('');
        $('#div_modificar').hide();
        $('#div_modificar').removeClass('ventana');
        $('#resto').removeClass('sombra');
    }

    fnjs_mod_bloque = function (formulario) {
        fnjs_mod_bloque_mensaje('');
        let id_tipo_doc = $("#k_buscar").val();

        let err = 0;
        // comprobar: tipo de documento seleccionado
        if (!id_tipo_doc) {
            fnjs_mod_bloque_mensaje(<?= json_encode(_("Debe seleccionar un tipo de documento")) ?>);
            err = 1;
        }

        // comprobar: algún documento seleccionado
        /* selecciono los elementos con class="sel" de las tablas del formulario */
        let documentos = '';
        $('#' + formulario + ' input.sel').each(function () {
            if ($(this).prop('checked') === true) {
                let array_dir = $(this).val().split('#');
                if (documentos !== '') {
                    documentos += '#';
                }
                documentos += array_dir[0];
            }
        });
        if (documentos === '') {
            fnjs_mod_bloque_mensaje(<?= json_encode(_("Debe seleccionar algún documento")) ?>);
            err = 1;
        }

        if (err !== 1) {
            $('#div_modificar').show();
            $('#div_modificar').addClass('ventana');
            $('#div_modificar').width('500');
            $('#div_modificar').height('360');
            $('#resto').addClass('sombra');

            let url = '<?= $url_bloque ?>';
            let parametros = 'id_tipo_doc=' + id_tipo_doc + '&documentos=' + documentos + '<?= $h1 ?>';
            fnjs_update_div('#div_modificar', url + '?' + parametros);
        }
    }

    fnjs_guardar = function (formulario) {
        let err = 0;

        fnjs_mod_bloque_form_mensaje(formulario, '');
        let chkCampos = $(formulario + ' input[type="checkbox"][name^="chk_"]');
        if (chkCampos.filter(':checked').length === 0) {
            fnjs_mod_bloque_form_mensaje(formulario, <?= json_encode(_("Debe marcar al menos un campo a modificar")) ?>);
            return;
        }

        let chk_f_recibido = $(formulario + ' input[name="chk_f_recibido"]').prop('checked');
        if (chk_f_recibido === true) {
            let f_recibido = $(formulario + ' input[name="f_recibido"]').val();
            // acepto el valor vacío para borrar
            if (f_recibido.length > 0 && !fnjs_comprobar_fecha_val('#f_recibido')) {
                err = 1;
            }
        }
        let chk_f_asignado = $(formulario + ' input[name="chk_f_asignado"]').prop('checked');
        if (chk_f_asignado === true) {
            let f_asignado = $(formulario + ' input[name="f_asignado"]').val();
            // acepto el valor vacío para borrar
            if (f_asignado.length > 0 && !fnjs_comprobar_fecha_val('#f_asignado')) {
                err = 1;
            }
        }
        let chk_f_eliminado = $(formulario + ' input[name="chk_f_eliminado"]').prop('checked');
        if (chk_f_eliminado === true) {
            let f_eliminado = $(formulario + ' input[name="f_eliminado"]').val();
            // acepto el valor vacío para borrar
            if (f_eliminado.length > 0 && !fnjs_comprobar_fecha_val('#f_eliminado')) {
                err = 1;
            }
        }

        if (err !== 1) {
            let datos = $(formulario).serialize();
            let request = $.ajax({
                data: datos,
                url: <?= json_encode($url_documentos_guardar ?? 'src/inventario/documentos_guardar', JSON_THROW_ON_ERROR) ?>,
                method: 'POST',
                dataType: 'json'
            });
            request.done(function (json) {
                if (json.success !== true) {
                    fnjs_mod_bloque_form_mensaje(formulario, json.mensaje || <?= json_encode(_("Error desconocido")) ?>);
                } else {
                    fnjs_mod_bloque_mensaje(<?= json_encode(_("guardado")) ?>, true);
                    $('#div_modificar').html('');
                    $('#div_modificar').hide();
                    $('#div_modificar').removeClass('ventana');
                    $('#resto').removeClass('sombra');
                    fnjs_enviar_formulario('#frm_buscar', '#exportar');
                }
            });
            request.fail(function (xhr) {
                let mensaje = <?= json_encode(_("Error en la conexión con el servidor")) ?>;
                if (xhr.responseJSON && xhr.responseJSON.mensaje) {
                    mensaje = xhr.responseJSON.mensaje;
                }
                fnjs_mod_bloque_form_mensaje(formulario, mensaje);
            });
        }
    }

</script>
